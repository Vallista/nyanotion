{
  "name": "@nyanotion/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate && tsx scripts/sync-vector.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "smoke": "pnpm smoke:documents && pnpm smoke:search && pnpm smoke:props",
    "seed": "tsx scripts/seed-welcome.ts",
    "smoke:search": "tsx scripts/smoke-search.ts",
    "smoke:props": "tsx scripts/smoke-properties.ts",
    "smoke:documents": "tsx scripts/smoke-documents.ts",
    "vector": "tsx scripts/sync-vector.ts"
  },
  "dependencies": {
    "@nyanotion/shared": "workspace:^",
    "@paralleldrive/cuid2": "^3.3.0",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
