# ─────────────────────────────────────────────────────────────────────────────
# Nyanotion 설정 본보기.  cp .env.example .env  로 시작한다.
#
# **이 저장소는 공개돼 있다.** `.env*` 는 전부 git 무시지만, 진짜 비밀값은 저장소 밖에 두는
# 편이 안전하다 — `NYANOTION_SECRETS_DIR` 를 가리키면 거기의 `<환경>.env` 를 먼저 읽는다.
#
# 읽는 차례 (먼저 잡힌 값이 이긴다):
#   1) 셸 환경 변수
#   2) $NYANOTION_SECRETS_DIR/<환경>.env      ← 비밀값
#   3) <저장소>/.env.<환경>                    ← 그 환경 설정
#   4) <저장소>/.env                           ← 공통 기본값  (이 파일)
#
# 환경은 셋이다:  dev(로컬 개발) · beta(먼저 시험) · prod(가족이 쓰는 것)
# 자세한 건 docs/07-environments.md.
# ─────────────────────────────────────────────────────────────────────────────

# 아무것도 안 주면 dev 다. 서비스·배포 스크립트가 beta/prod 를 넣어 준다.
NYANOTION_ENV=dev

# 비밀값을 둘 폴더 (저장소 밖 권장). 비워 두면 .env 만 쓴다.
# 예: C:\nyanotion\secrets
NYANOTION_SECRETS_DIR=

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
# 환경마다 **다른 DB** 를 쓴다. 마이그레이션은 beta 에서 먼저 돌려 볼 것.
#   dev → nyanotion_dev   beta → nyanotion_beta   prod → nyanotion
DATABASE_URL=postgres://nyanotion:change_me@localhost:5432/nyanotion_dev

# ── 인증 ─────────────────────────────────────────────────────────────────────
# 비밀값. 환경마다 다르게. 만들기: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me
BETTER_AUTH_URL=http://localhost:3000

# 가족만 — 초대 토큰 없이는 가입 불가. true 로 만들지 말 것.
ALLOW_PUBLIC_SIGNUP=false

# 이 서버를 여는 주소를 전부 적는다 (쉼표 구분). 여기 없는 Origin 으로 들어오면
# 로그인이 "invalid origin" 으로 막힌다 (Better Auth 의 CSRF 방어).
# BETTER_AUTH_URL 은 자동으로 포함된다. 집 랜 IP · Tailscale IP · 터널 도메인을 그때그때 추가.
TRUSTED_ORIGINS=

# ── 포트 ─────────────────────────────────────────────────────────────────────
# dev 3000/1234 · beta 3100/1334 · prod 3000/1234 (운영은 터널이 3000 을 본다)
PORT=3000
COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_PORT=1234
# 터널처럼 주소가 아주 달라질 때만 못 박는다. 비워 두면 지금 연 주소에서 만든다.
NEXT_PUBLIC_COLLAB_URL=

# ── 올린 파일 ────────────────────────────────────────────────────────────────
# 비워 두면 apps/web/.data/uploads. 환경마다 달라야 섞이지 않는다.
UPLOAD_DIR=

# ── 로컬 LLM (냥이) ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_CHAT_MODEL=exaone3.5:2.4b
AI_EMBED_MODEL=bge-m3
AI_EMBED_DIM=1024
AI_MAX_CONCURRENCY=1
AI_TIMEOUT_MS=120000
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── 웹 푸시 (알림) ───────────────────────────────────────────────────────────
# 만들기: pnpm --filter @nyanotion/notify keys
# 환경마다 다른 키를 쓴다. **바꾸면 켜 둔 기기들의 알림이 전부 끊긴다.**
# 공개키는 비밀이 아니다(브라우저가 받아 간다). 개인키는 비밀이다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.example

# ── 구매 에이전트 (apps/agent) ───────────────────────────────────────────────
# 네이버 쇼핑 검색은 **공식 API** 를 쓴다 (무료·합법·안 깨짐).
#   https://developers.naver.com → 애플리케이션 등록 → 검색 API
# 없으면 쿠팡만으로 찾는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 브라우저 프로필 — **쿠팡·네이버 로그인 쿠키가 들어간다. 저장소 밖에 둘 것.**
# 비우면 ~/.nyanotion/browser-profile
AGENT_PROFILE_DIR=
# 1 이면 창을 숨긴다. 기본은 띄운다 — 사람이 보고 있어야 맡길 수 있다.
AGENT_HEADLESS=0
AGENT_POLL_MS=15000
AGENT_MAX_OFFERS=5
AGENT_POLITE_MS=1500
