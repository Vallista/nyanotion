# .env — 저장소 루트 하나로 관리한다. git 무시됨. 커밋 금지.
# 복사: cp .env.example .env
# PostgreSQL 17 은 Windows 서비스로 직접 돈다. POSTGRES_* 는 infra/docker-compose.yml 를
# 되살릴 때만 쓴다 (docs/03-dev-environment.md 참고).
POSTGRES_USER=nyanotion
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nyanotion

DATABASE_URL=postgres://nyanotion:change_me@localhost:5432/nyanotion

BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# 가족만 — 초대 토큰 없이는 가입 불가. true 로 만들지 말 것.
ALLOW_PUBLIC_SIGNUP=false

# 이 서버를 여는 주소를 전부 적는다 (쉼표 구분). 여기 없는 Origin 으로 들어오면
# 로그인이 "invalid origin" 으로 막힌다 (Better Auth 의 CSRF 방어).
# BETTER_AUTH_URL 은 자동으로 포함된다. 집 랜 IP · Tailscale IP · 터널 도메인을 그때그때 추가할 것.
# 예: http://192.168.0.12:3000,http://100.x.y.z:3000,https://nyanotion.example.com
TRUSTED_ORIGINS=

# M2~
# 동기화 서버(apps/collab).
# 브라우저는 기본적으로 "지금 연 주소 + 이 포트"로 붙는다 — 폰에서 IP 로 열어도 그대로 된다.
# 터널처럼 주소가 아주 달라질 때만 NEXT_PUBLIC_COLLAB_URL 로 못 박는다 (예: wss://nyanotion.example.com/collab).
COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_URL=
CLOUDFLARE_TUNNEL_TOKEN=

# M5~ (호스트 Ollama. 컨테이너에서 부를 때는 host.docker.internal)
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_CHAT_MODEL=exaone3.5:2.4b
AI_EMBED_MODEL=bge-m3
AI_EMBED_DIM=1024
AI_MAX_CONCURRENCY=1
AI_TIMEOUT_MS=120000
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
