# 베타 — 먼저 시험해 보는 자리. `.env.beta` 로 복사해서 쓴다.
# 여기 값은 `.env` 보다 **먼저** 읽히므로, 달라지는 것만 적는다.
#
# 규칙: **마이그레이션은 여기서 먼저 돌린다.** 가족 문서에 처음 돌려 보는 일이 없게.
NYANOTION_ENV=beta

DATABASE_URL=postgres://nyanotion:change_me@localhost:5432/nyanotion_beta

BETTER_AUTH_SECRET=change_me
BETTER_AUTH_URL=https://beta.nyanotion.party
TRUSTED_ORIGINS=https://beta.nyanotion.party,http://localhost:3100

PORT=3100
COLLAB_PORT=1334
NEXT_PUBLIC_COLLAB_PORT=1334
NEXT_PUBLIC_COLLAB_URL=wss://collab-beta.nyanotion.party

UPLOAD_DIR=C:\nyanotion\uploads\beta
