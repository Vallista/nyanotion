# 운영 — 가족이 실제로 쓰는 것. `.env.prod` 로 복사해서 쓴다.
#
# 비밀값(BETTER_AUTH_SECRET·DATABASE_URL)은 **저장소 밖**에 두는 것을 권한다:
#   NYANOTION_SECRETS_DIR=C:\nyanotion\secrets   →  C:\nyanotion\secrets\prod.env
# 그러면 이 파일에는 포트·도메인만 남는다.
NYANOTION_ENV=prod

DATABASE_URL=postgres://nyanotion:change_me@localhost:5432/nyanotion

BETTER_AUTH_SECRET=change_me
BETTER_AUTH_URL=https://nyanotion.party
TRUSTED_ORIGINS=https://nyanotion.party

PORT=3000
COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_URL=wss://collab.nyanotion.party

UPLOAD_DIR=C:\nyanotion\uploads\prod

# ── 웹 푸시 (알림) ───────────────────────────────────────────────────────────
# 만들기: pnpm --filter @nyanotion/notify keys
# 환경마다 다른 키를 쓴다. **바꾸면 켜 둔 기기들의 알림이 전부 끊긴다.**
# 공개키는 비밀이 아니다(브라우저가 받아 간다). 개인키는 비밀이다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.example
