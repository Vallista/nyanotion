{
  "name": "nyanotion",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "setup": "pwsh scripts/setup.ps1",
    "dev": "pwsh scripts/run.ps1 -Env dev",
    "dev:web": "pnpm --filter @nyanotion/web dev",
    "dev:collab": "pnpm --filter @nyanotion/collab dev",
    "serve:beta": "pwsh scripts/run.ps1 -Env beta -Build",
    "serve:prod": "pwsh scripts/run.ps1 -Env prod -Build",
    "stop:beta": "pwsh scripts/run.ps1 -Env beta -Stop",
    "stop:prod": "pwsh scripts/run.ps1 -Env prod -Stop",
    "build": "pnpm --filter @nyanotion/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present smoke",
    "db:generate": "pnpm --filter @nyanotion/db generate",
    "db:migrate": "pnpm --filter @nyanotion/db migrate",
    "db:studio": "pnpm --filter @nyanotion/db studio",
    "db:seed": "pnpm --filter @nyanotion/db seed",
    "agent": "pnpm --filter @nyanotion/agent start",
    "agent:login": "pnpm --filter @nyanotion/agent login",
    "agent:once": "pnpm --filter @nyanotion/agent once",
    "worker": "pnpm --filter @nyanotion/worker start",
    "worker:once": "pnpm --filter @nyanotion/worker once",
    "db:vector": "pnpm --filter @nyanotion/db vector"
  }
}
