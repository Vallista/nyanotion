{
  "name": "@nyanotion/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "reindex": "tsx scripts/reindex.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-calendar.ts && tsx scripts/smoke-rag.ts",
    "smoke:calendar": "tsx scripts/smoke-calendar.ts"
  },
  "dependencies": {
    "@nyanotion/ai": "workspace:*",
    "@nyanotion/db": "workspace:*",
    "@nyanotion/notify": "workspace:*",
    "@nyanotion/shared": "workspace:*",
    "ical.js": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "drizzle-orm": "^0.36.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
